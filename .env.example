# ==============================================================================
# State Panel - Environment Variables & Secrets (.env)
# ==============================================================================
# Copia este archivo como .env para definir tus variables de entorno locales:
#   cp .env.example .env

# URLs y Endpoints de Servicios
OUTLINE_URL=https://mimamita.site
HERMES_URL=https://hermes.example.com/health
CRM_URL=https://crm.example.com

# Notificaciones ntfy (Pub/Sub)
NTFY_ENABLED=false
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=my-private-state-panel-topic
NTFY_TOKEN=

# Cloudflare Deploy (Opcional para despliegue desde CLI o CI/CD)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
